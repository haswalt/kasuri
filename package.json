{
  "name": "kasuri",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm build && wrangler dev --ip 127.0.0.1",
    "build": "node scripts/cloudflare-build.mjs",
    "build:worker": "worker-build crates/workflow-worker --release --no-opt",
    "build:web": "pnpm --filter web build",
    "build:selfhost": "pnpm build && node scripts/build-selfhost.mjs",
    "start": "sh scripts/start-selfhost.sh",
    "dev:web": "pnpm --filter web dev",
    "test": "pnpm test:web && pnpm test:rust && pnpm test:runtime",
    "test:web": "pnpm --filter web test",
    "test:rust": "cargo test --workspace",
    "test:runtime": "node scripts/test-runtime.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "setup:selfhost": "node scripts/setup-selfhost.mjs",
    "setup:repository": "node scripts/configure-repository.mjs",
    "test:container": "node scripts/test-container.mjs",
    "test:examples:live": "node scripts/test-examples-live.mjs",
    "test:data": "node scripts/test-runtime.mjs --data-only"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "private": true,
  "devDependencies": {
    "wrangler": "^4.166.0",
    "workerd": "1.20261121.1"
  },
  "cloudflare": {
    "bindings": {
      "WORKSPACES": {
        "description": "Persistent workflows, Rust run checkpoints and cron/wait alarms in SQLite-backed Durable Objects."
      }
    }
  }
}
