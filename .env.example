# Optional host port for Docker Compose
PORT=8080
# Optional restriction: empty allows public HTTPS destinations
HTTP_ALLOWED_HOSTS=

# Explicit private host opt-in; also requires private network connectivity/policy
HTTP_PRIVATE_HOSTS=

# Optional cap on concurrently active runs per workspace; empty means no count limit
MAX_ACTIVE_RUNS=
# Finished runs kept per workflow (empty: 100; 0 or unlimited: no count limit)
RUN_HISTORY=
# Optional age limit in days for finished runs, and a separate one for failed runs
RUN_HISTORY_DAYS=
FAILED_RUN_HISTORY_DAYS=
# Where runs execute: empty or "objects" (default: one Durable Object per run tree),
# "queues" (run objects stepped by queue messages; uses workerd's experimental
# Queues Worker when self-hosting), or "workspace" (legacy fallback).
RUN_EXECUTION=
# Optional JSON map of named HTTP secrets; use secret mounts in production
HTTP_SECRETS={}

# Canonical external HTTPS origin when self-hosting behind a TLS reverse proxy
PUBLIC_ORIGIN=
