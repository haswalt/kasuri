{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasuri",
  "workers_dev": true,
  "main": "crates/workflow-worker/build/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkflowWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkflowWorkspace"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
