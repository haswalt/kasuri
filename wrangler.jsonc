{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasuri",
  "workers_dev": true,
  "main": "crates/workflow-worker/build/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Enable on trusted deployments that want live Clairic inference.
  // "ai": { "binding": "AI" },
  // Enable only with an onboarded sending domain and explicitly routed workspaces.
  // "send_email": [{ "name": "EMAIL" }],
  // Optional private bucket for workflow attachments. Set a bucket lifecycle.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "kasuri-files" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkflowWorkspace"
      },
      {
        "name": "RUNS",
        "class_name": "WorkflowRun"
      }
    ]
  },
  // Run messages for RUN_EXECUTION=queues. Unused (and free) otherwise.
  "queues": {
    "producers": [
      {
        "binding": "RUN_QUEUE",
        "queue": "kasuri-runs"
      }
    ],
    "consumers": [
      {
        "queue": "kasuri-runs",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkflowWorkspace"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "WorkflowRun"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
