{
  "schemaVersion": 2,
  "id": "32-clairic-booking-reply",
  "name": "Clairic booking enquiry: reply",
  "description": "Simulate with {}. Uses a synthetic booking email and offline answers to preview routing. This example does not send email.",
  "status": "draft",
  "revision": 0,
  "updatedAt": "",
  "nodes": [
    {
      "id": "start",
      "type": "Manual Trigger",
      "label": "Start offline example",
      "config": {}
    },
    {
      "id": "email",
      "type": "Map / Transform",
      "label": "Example email",
      "config": {
        "mapping": {
          "body": "Hello, can we book the Example Quartet for 2027-06-12? We expect 80 guests and have a budget of GBP 1500 for the band. Thanks, Jamie Example"
        }
      }
    },
    {
      "id": "extract",
      "type": "Clairic",
      "label": "Extract booking details",
      "config": {
        "inputPointer": "/body",
        "fields": [
          {
            "name": "name",
            "type": "text",
            "instructions": "Name of the person who sent the enquiry."
          },
          {
            "name": "enquiry",
            "type": "enum",
            "enum": [
              "booking",
              "other"
            ],
            "instructions": "Is the sender enquiring about booking a band?"
          },
          {
            "name": "event_date",
            "type": "date",
            "instructions": "Date the band would perform."
          },
          {
            "name": "guest_count",
            "type": "number",
            "instructions": "Number of expected guests."
          },
          {
            "name": "budget",
            "type": "number",
            "instructions": "Maximum budget for the band, without the currency."
          },
          {
            "name": "currency",
            "type": "text",
            "instructions": "Currency explicitly given, if available."
          },
          {
            "name": "band",
            "type": "text",
            "instructions": "Name of the requested band."
          }
        ],
        "simulationResponse": {
          "answers": {
            "name": {
              "value": "Jamie Example"
            },
            "enquiry": {
              "value": "booking"
            },
            "event_date": {
              "value": "2027-06-12"
            },
            "guest_count": {
              "value": 80
            },
            "budget": {
              "value": 1500
            },
            "currency": {
              "value": "GBP"
            },
            "band": {
              "value": "Example Quartet"
            }
          }
        }
      }
    },
    {
      "id": "route",
      "type": "IF / Condition",
      "label": "Ready for a reply?",
      "config": {
        "match": "all",
        "conditions": [
          {
            "field": "values.enquiry",
            "operator": "equals",
            "valueType": "string",
            "value": "booking"
          },
          {
            "field": "values.event_date",
            "operator": "is_not_empty"
          },
          {
            "field": "values.budget",
            "operator": "is_not_empty"
          },
          {
            "field": "values.currency",
            "operator": "is_not_empty"
          },
          {
            "field": "values.guest_count",
            "operator": "greater_than",
            "valueType": "number",
            "value": 0
          },
          {
            "field": "truncated",
            "operator": "equals",
            "valueType": "boolean",
            "value": false
          }
        ]
      }
    },
    {
      "id": "reply",
      "type": "Map / Transform",
      "label": "Prepare reply",
      "config": {
        "mapping": {
          "action": "reply",
          "booking": {
            "$input": "/values"
          }
        }
      }
    },
    {
      "id": "handoff",
      "type": "Map / Transform",
      "label": "Prepare human handoff",
      "config": {
        "mapping": {
          "action": "handoff",
          "booking": {
            "$input": "/values"
          },
          "email": {
            "$input": "/email"
          }
        }
      },
      "inputBindings": {
        "values": {
          "op": "input",
          "path": "/values"
        },
        "email": {
          "op": "node",
          "nodeId": "email",
          "path": "/body"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "start-email",
      "source": "start",
      "target": "email"
    },
    {
      "id": "email-extract",
      "source": "email",
      "target": "extract"
    },
    {
      "id": "extract-route",
      "source": "extract",
      "target": "route"
    },
    {
      "id": "route-reply",
      "source": "route",
      "target": "reply",
      "sourcePort": "true"
    },
    {
      "id": "route-handoff",
      "source": "route",
      "target": "handoff",
      "sourcePort": "false"
    }
  ]
}
