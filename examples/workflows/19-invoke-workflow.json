          }
        }
      }
    },
    {
      "id": "background",
      "type": "Execute Workflow",
      "label": "Continue independently",
      "config": {
        "workflowId": "18-reusable-workflow",
        "mode": "background"
      }
    }
  ],
  "edges": [
