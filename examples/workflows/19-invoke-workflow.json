{
  "schemaVersion": 1,
  "id": "19-invoke-workflow",
  "name": "Await a reusable workflow then start background work",
  "description": "Import and publish example 18 first. Calls its published definition, reads the result, then launches another simulated or real child in the same mode.",
  "status": "draft",
  "revision": 0,
  "updatedAt": "",
  "nodes": [
