{
  "schemaVersion": 1,
  "id": "24-each-items",
  "name": "Process items then aggregate results",
  "description": "Import and publish example 23 first, then import this caller. Processes each synthetic item durably and sums the ordered outputs.",
  "status": "draft",
  "revision": 0,
  "updatedAt": "",
  "nodes": [
    {
      "id": "start",
      "type": "Manual Trigger",
      "label": "Start",
      "config": {}
    },
    {
      "id": "prepare",
      "type": "Map / Transform",
      "label": "Synthetic items",
      "config": {
        "mapping": {
          "items": [
            {
              "amount": 1
            },
            {
              "amount": 2
            },
            {
              "amount": 3
            }
          ]
        }
      }
    },
    {
      "id": "each",
      "type": "Each / Loop",
      "label": "Process each item",
      "config": {
        "workflowId": "23-item-worker",
        "arrayPointer": "/items",
        "concurrency": 2,
        "failurePolicy": "fail"
      }
    },
    {
      "id": "total",
      "type": "Aggregate",
      "label": "Sum successful amounts",
      "config": {
        "arrayPointer": "/items",
        "pointer": "/output/item/amount",
        "operation": "sum"
      }
    }
  ],
  "edges": [
    {
      "id": "a",
      "source": "start",
      "target": "prepare"
    },
    {
      "id": "b",
      "source": "prepare",
      "target": "each"
    },
    {
      "id": "c",
      "source": "each",
      "target": "total"
    }
  ]
}
