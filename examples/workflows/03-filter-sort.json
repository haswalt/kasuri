{
  "schemaVersion": 1,
  "id": "03-filter-sort",
  "name": "Filter and sort sample records",
  "description": "Create synthetic records, select active records and sort by rank. No input required.",
  "status": "draft",
  "revision": 0,
  "updatedAt": "2026-11-18T00:00:00Z",
  "nodes": [
    {
      "id": "start",
      "type": "Manual Trigger",
      "label": "Manual Trigger",
      "version": 1,
      "config": {},
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "sample",
      "type": "Map / Transform",
      "label": "Map / Transform",
      "version": 1,
      "config": {
        "mapping": {
          "items": [
            {
              "name": "Cedar",
              "active": true,
              "rank": 3
            },
            {
              "name": "Birch",
              "active": false,
              "rank": 2
            },
            {
              "name": "Alder",
              "active": true,
              "rank": 1
            }
          ]
        }
      },
      "position": {
        "x": 320,
        "y": 180
      }
    },
    {
      "id": "active",
      "type": "Filter",
      "label": "Filter",
      "version": 1,
      "config": {
        "arrayPointer": "/items",
        "match": "all",
        "conditions": [
          {
            "field": "active",
            "operator": "equals",
            "valueType": "boolean",
            "value": true
          },
          {
            "field": "rank",
            "operator": "greater_or_equal",
            "valueType": "number",
            "value": 1
          }
        ]
      },
      "position": {
        "x": 0,
        "y": 360
      }
    },
    {
      "id": "ordered",
      "type": "Sort",
      "label": "Sort",
      "version": 1,
      "config": {
        "pointer": "/rank",
        "order": "asc"
      },
      "position": {
        "x": 320,
        "y": 540
      }
    }
  ],
  "edges": [
    {
      "id": "e0",
      "source": "start",
      "target": "sample",
      "sourcePort": "success"
    },
    {
      "id": "e1",
      "source": "sample",
      "target": "active",
      "sourcePort": "success"
    },
    {
      "id": "e2",
      "source": "active",
      "target": "ordered",
      "sourcePort": "success"
    }
  ]
}
